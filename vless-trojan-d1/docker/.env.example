# vless-trojan-d1 Docker 部署环境变量
# 用法：复制为 docker/.env 后按需修改，再执行 docker compose up -d

# 正式域名（必填，模式一自动 HTTPS 时）
# 需已解析 A/AAAA 记录到本机公网 IP，且 80/443 端口对外可达
# 纯 HTTP 模式（无证书）可留空，并切换 Caddyfile 为模式三
DOMAIN=your.domain.com

# ACME 账户邮箱（可选，用于证书到期通知；留空则 Caddy 自动处理）
ACME_EMAIL=you@example.com

# 可选：worker 容器内监听端口（默认 8787，一般无需修改）
# PORT=8787
